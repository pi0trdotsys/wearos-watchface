<?xml version="1.0" encoding="utf-8"?>
<!--
  Nine Eleven - Watch Face Format v2 document.

  Visual language ported from the approved TypeScript mockups
  (wear-os-car-mockups): near-black ground, one ember accent used
  sparingly, hairline dividers, tiny wide-tracked uppercase mono labels.
  All pixel positions below are lifted directly from that mockup's
  WatchFace.tsx (already authored in this same 480x480 space) and from
  tools/gen_art.py's render_preview(), which mirrors it - so the shipped
  face and the generated preview image stay in lockstep.

  Layout, top to bottom:
      y  62 .. 120   energy score (complication slot)
      y 150 .. 270   car silhouette (8 selectable bodies, tinted)
      y 266          hairline divider
      y 282 .. 322   KROKI | TEMP | BATERIA
      y 334 .. 422   24-hour clock, seven-segment (the one exception to
                     the mockup's Saira Condensed numerals, kept by request)

  Two user configurations:
      theme  ->  [CONFIGURATION.theme.0] the single accent color
      car    ->  which of the 8 silhouettes is drawn

  Ambient keeps only what a dark panel can hold cheaply: the tick ring's
  major marks, an outline car, the energy value with no segment bar, the
  clock over a dimmed "88:88" segment field, and a small battery read-out
  - exactly WatchFace.tsx's `ambient` branch.
-->
<WatchFace width="480" height="480" clipShape="CIRCLE">

    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="21:47:00" />

    <UserConfigurations>
        <ColorConfiguration id="theme" displayName="cfg_theme" defaultValue="ember">
            <ColorOption id="ember"   displayName="theme_ember"   colors="#fb6d27" />
            <ColorOption id="crimson" displayName="theme_crimson" colors="#e2211c" />
            <ColorOption id="amber"   displayName="theme_amber"   colors="#ffb000" />
            <ColorOption id="acid"    displayName="theme_acid"    colors="#b4ff39" />
            <ColorOption id="ice"     displayName="theme_ice"     colors="#4fd1ff" />
            <ColorOption id="magenta" displayName="theme_magenta" colors="#ff3d8b" />
            <ColorOption id="mint"    displayName="theme_mint"    colors="#2be8b0" />
            <ColorOption id="mono"    displayName="theme_mono"    colors="#e8ecf4" />
        </ColorConfiguration>

        <ListConfiguration id="car" displayName="cfg_car" defaultValue="porsche_911">
            <ListOption id="porsche_911"     displayName="car_porsche_911" />
            <ListOption id="cybertruck"      displayName="car_cybertruck" />
            <ListOption id="challenger"      displayName="car_challenger" />
            <ListOption id="mustang"         displayName="car_mustang" />
            <ListOption id="continental_gt"  displayName="car_continental_gt" />
            <ListOption id="mini"            displayName="car_mini" />
            <ListOption id="chiron"          displayName="car_chiron" />
            <ListOption id="g_wagen"         displayName="car_g_wagen" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff08090f">

        <!-- ============================ background ======================= -->
        <PartImage name="backdrop" x="0" y="0" width="480" height="480" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="backdrop" />
        </PartImage>

        <PartImage name="tick_ring" x="0" y="0" width="480" height="480" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="tick_ring" />
        </PartImage>

        <PartImage name="tick_ring_aod" x="0" y="0" width="480" height="480" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Image resource="tick_ring_aod" />
        </PartImage>

        <!-- Minute-progress sweep - the one live element on the ring. -->
        <PartDraw name="sweep" x="0" y="0" width="480" height="480" alpha="230">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Arc centerX="240" centerY="240" width="462" height="462"
                 startAngle="0" endAngle="0" direction="CLOCKWISE">
                <Transform target="endAngle"
                           value="([MINUTE] + [SECOND] / 60) * 6" />
                <Stroke color="[CONFIGURATION.theme.0]" thickness="2" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- ======================= energy score =========================
             Watch Face Format has no system source for Samsung Health's
             Energy score - the health sources are steps and heart rate only
             - and Samsung Health itself registers no complication provider
             for it either (checked directly against a Galaxy Watch Ultra:
             `dumpsys package com.samsung.android.wear.shealth` lists
             providers for steps, SpO2, sleep, stress, heart rate, exercise -
             never energy score).

             `energy-bridge-watch` is a small companion provider app that
             fills that gap: `energy-bridge-companion` (phone) reads the
             score and pushes it over the Data Layer to
             `EnergyScoreComplicationService` (watch), which serves it as a
             SHORT_TEXT complication. DefaultProviderPolicy pre-selects it,
             so the score appears without the wearer configuring anything -
             assuming both bridge apps are installed; if not, the slot falls
             back to EMPTY and can still be pointed at any other provider by
             hand, same as before. Every value shape a provider can send is
             handled, not just SHORT_TEXT, and the 16-chip bar only appears
             for the numeric types, where a fill fraction exists to compute. -->
        <ComplicationSlot name="energy" slotId="1"
                          x="120" y="60" width="240" height="62"
                          displayName="slot_energy"
                          supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS EMPTY"
                          alpha="255">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="dev.rosinski.watchface.energybridge/.EnergyScoreComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="240" height="62" />
            <Variant mode="AMBIENT" target="alpha" value="204" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="240" height="18">
                    <Text align="CENTER">
                        <Font family="ibm_plex_mono_medium" size="10"
                              color="#ff8e929a" letterSpacing="0.2">
                            <![CDATA[ENERGIA]]>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="20" width="240" height="34">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="30"
                              color="[CONFIGURATION.theme.0]">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="240" height="18">
                    <Text align="CENTER">
                        <Font family="ibm_plex_mono_medium" size="10"
                              color="#ff8e929a" letterSpacing="0.2">
                            <![CDATA[ENERGIA]]>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="20" width="240" height="34">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="30"
                              color="[CONFIGURATION.theme.0]">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
                <Group name="energy_bar_ranged" x="66" y="54" width="108" height="8" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <PartImage x="0" y="0" width="108" height="8" alpha="90">
                        <Image resource="energy_gap_mask" />
                    </PartImage>
                    <Group name="energy_fill_ranged" x="0" y="0" width="108" height="8"
                           pivotX="0" pivotY="0.5" scaleX="1">
                        <Transform target="scaleX"
                                   value="clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN] + 0.0001), 0, 1)" />
                        <PartImage x="0" y="0" width="108" height="8"
                                   tintColor="[CONFIGURATION.theme.0]">
                            <Image resource="energy_gap_mask" />
                        </PartImage>
                    </Group>
                </Group>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartText x="0" y="0" width="240" height="18">
                    <Text align="CENTER">
                        <Font family="ibm_plex_mono_medium" size="10"
                              color="#ff8e929a" letterSpacing="0.2">
                            <![CDATA[ENERGIA]]>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="20" width="240" height="34">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="30"
                              color="[CONFIGURATION.theme.0]">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
                <Group name="energy_bar_goal" x="66" y="54" width="108" height="8" alpha="255">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <PartImage x="0" y="0" width="108" height="8" alpha="90">
                        <Image resource="energy_gap_mask" />
                    </PartImage>
                    <Group name="energy_fill_goal" x="0" y="0" width="108" height="8"
                           pivotX="0" pivotY="0.5" scaleX="1">
                        <Transform target="scaleX"
                                   value="clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / ([COMPLICATION.GOAL_PROGRESS_TARGET_VALUE] + 0.0001), 0, 1)" />
                        <PartImage x="0" y="0" width="108" height="8"
                                   tintColor="[CONFIGURATION.theme.0]">
                            <Image resource="energy_gap_mask" />
                        </PartImage>
                    </Group>
                </Group>
            </Complication>

            <Complication type="EMPTY">
                <PartText x="0" y="0" width="240" height="18">
                    <Text align="CENTER">
                        <Font family="ibm_plex_mono_medium" size="10"
                              color="#ff8e929a" letterSpacing="0.2">
                            <![CDATA[ENERGIA]]>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="20" width="240" height="34">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="30" color="#ff3c4452">
                            <![CDATA[--]]>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- =========================== temperature ========================
             Not a raw [WEATHER.*] read: that depends on the phone/watch
             weather setup, with no way for the user to fix it from the
             watch face - a fixed source is also not tappable in the
             editor. As a complication slot it is configurable exactly
             like Energy. DefaultProviderPolicy pre-selects Samsung's own
             Weather app - confirmed present on the Galaxy Watch Ultra via
             `dumpsys package com.samsung.android.watch.weather`, which
             registers WeatherComplicationService as SHORT_TEXT/LONG_TEXT,
             plus separate feels-like/UV/precipitation providers - so the
             wearer gets a working value immediately and can still swap to
             any of those from the editor.                                -->
        <ComplicationSlot name="temp" slotId="2"
                          x="194" y="298" width="94" height="26"
                          displayName="slot_temp"
                          supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE EMPTY"
                          alpha="255">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY"
                primaryProvider="com.samsung.android.watch.weather/.complication.WeatherComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="94" height="26" />
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="94" height="26">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="26" color="#fff4f5f8">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="94" height="26">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="26" color="#fff4f5f8">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="94" height="26">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="26" color="#fff4f5f8">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="94" height="26">
                    <Text align="CENTER">
                        <Font family="saira_condensed_regular" size="26" color="#ff3c4452">
                            <![CDATA[--]]>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ============================== car ============================
             One flat white silhouette per body, tinted with the theme
             accent, plus a wireframe twin that takes over in ambient.     -->
        <ListConfiguration id="car">
            <ListOption id="porsche_911">
                <Group name="car_porsche_911" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_porsche_911" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_porsche_911_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="cybertruck">
                <Group name="car_cybertruck" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_cybertruck" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_cybertruck_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="challenger">
                <Group name="car_challenger" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_challenger" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_challenger_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="mustang">
                <Group name="car_mustang" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_mustang" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_mustang_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="continental_gt">
                <Group name="car_continental_gt" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_continental_gt" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_continental_gt_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="mini">
                <Group name="car_mini" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_mini" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_mini_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="chiron">
                <Group name="car_chiron" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_chiron" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_chiron_aod" />
                    </PartImage>
                </Group>
            </ListOption>

            <ListOption id="g_wagen">
                <Group name="car_g_wagen" x="80" y="150" width="320" height="120">
                    <PartImage x="0" y="0" width="320" height="120" alpha="255"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Image resource="car_g_wagen" />
                    </PartImage>
                    <PartImage x="0" y="0" width="320" height="120" alpha="0"
                               tintColor="[CONFIGURATION.theme.0]">
                        <Variant mode="AMBIENT" target="alpha" value="255" />
                        <Image resource="car_g_wagen_aod" />
                    </PartImage>
                </Group>
            </ListOption>
        </ListConfiguration>

        <!-- ====================== steps | temp | battery ================= -->
        <Group name="metrics" x="0" y="0" width="480" height="480" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw name="metric_hairlines" x="0" y="0" width="480" height="480">
                <Rectangle x="96" y="266" width="288" height="1">
                    <Fill color="#29ffffff" />
                </Rectangle>
                <Rectangle x="192" y="282" width="1" height="40">
                    <Fill color="#14ffffff" />
                </Rectangle>
                <Rectangle x="288" y="282" width="1" height="40">
                    <Fill color="#14ffffff" />
                </Rectangle>
            </PartDraw>

            <PartText name="steps_label" x="98" y="282" width="94" height="16">
                <Text align="CENTER">
                    <Font family="ibm_plex_mono_medium" size="10"
                          color="#ff8e929a" letterSpacing="0.3">
                        <![CDATA[KROKI]]>
                    </Font>
                </Text>
            </PartText>
            <PartText name="steps_value" x="98" y="298" width="94" height="26">
                <Text align="CENTER">
                    <Font family="saira_condensed_regular" size="26" color="#fff4f5f8">
                        <Template><![CDATA[%d]]>
                            <Parameter expression="[STEP_COUNT]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>

            <PartText name="temp_label" x="194" y="282" width="94" height="16">
                <Text align="CENTER">
                    <Font family="ibm_plex_mono_medium" size="10"
                          color="#ff8e929a" letterSpacing="0.3">
                        <![CDATA[TEMP]]>
                    </Font>
                </Text>
            </PartText>


            <PartText name="battery_label" x="290" y="282" width="94" height="16">
                <Text align="CENTER">
                    <Font family="ibm_plex_mono_medium" size="10"
                          color="#ff8e929a" letterSpacing="0.3">
                        <![CDATA[BATERIA]]>
                    </Font>
                </Text>
            </PartText>

            <!-- Always accent-colored (WatchFace.tsx marks battery as the
                 one highlighted metric); overridden to red under 15%. -->
            <Condition>
                <Expressions>
                    <Expression name="battery_low">[BATTERY_PERCENT] &lt; 15</Expression>
                </Expressions>
                <Compare expression="battery_low">
                    <PartText name="battery_value_low" x="290" y="298" width="94" height="26">
                        <Text align="CENTER">
                            <Font family="saira_condensed_regular" size="26" color="#ffff3b30">
                                <Template><![CDATA[%d]]>
                                    <Parameter expression="[BATTERY_PERCENT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText name="battery_value" x="290" y="298" width="94" height="26">
                        <Text align="CENTER">
                            <Font family="saira_condensed_regular" size="26"
                                  color="[CONFIGURATION.theme.0]">
                                <Template><![CDATA[%d]]>
                                    <Parameter expression="[BATTERY_PERCENT]" />
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>

        <!-- ======================== 24-hour clock ========================
             The one place the mockup's Saira Condensed numerals were traded
             for the seven-segment face, by request. The unlit segment field
             behind the digits is what sells it as a real display; it stays
             on in ambient.                                                -->
        <PartText name="time_ghost" x="60" y="334" width="360" height="92" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="203" />
            <Text align="CENTER">
                <Font family="dseg7_bold" size="78" color="#1affffff">
                    <![CDATA[88:88]]>
                </Font>
            </Text>
        </PartText>

        <PartText name="time" x="60" y="334" width="360" height="92" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="235" />
            <Text align="CENTER">
                <Font family="dseg7_bold" size="78" color="#fff4f5f8">
                    <Template><![CDATA[%s:%s]]>
                        <Parameter expression="[HOUR_0_23_Z]" />
                        <Parameter expression="[MINUTE_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Ambient-only battery readout, standing in for the row above. -->
        <PartText name="battery_ambient" x="0" y="414" width="480" height="16" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Text align="CENTER">
                <Font family="ibm_plex_mono_medium" size="10"
                      color="#ff8e929a" letterSpacing="0.2">
                    <Template><![CDATA[%d%%]]>
                        <Parameter expression="[BATTERY_PERCENT]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

    </Scene>
</WatchFace>
